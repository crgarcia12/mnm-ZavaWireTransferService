<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.zavabank.wiretransfer.HealthServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>WireBootstrapServlet</servlet-name>
        <servlet-class>com.zavabank.wiretransfer.WireBootstrapServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>WireTransferServlet</servlet-name>
        <servlet-class>com.zavabank.wiretransfer.WireTransferServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>WireStatusServlet</servlet-name>
        <servlet-class>com.zavabank.wiretransfer.WireStatusServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>WireBootstrapServlet</servlet-name>
        <url-pattern>/internal/bootstrap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>WireTransferServlet</servlet-name>
        <url-pattern>/api/wire/transfer</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>WireStatusServlet</servlet-name>
        <url-pattern>/api/wire/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
